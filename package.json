{
  "name": "scraping-ai-bot-cloud",
  "version": "2.0.0",
  "description": "Cloud-hosted AI scraping bot — multi-device, Redis-backed, auth-protected",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "install:browsers": "npx playwright install chromium --with-deps",
    "setup": "npm install && npm run install:browsers"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "json2csv": "^6.0.0-alpha.2",
    "playwright": "^1.44.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
