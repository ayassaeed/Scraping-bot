# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Redis (strongly recommended for cloud — jobs persist across restarts) ──────
# Railway:  REDIS_URL auto-set when you add the Redis plugin
# Render:   Add Redis service, copy Internal Redis URL
# Fly.io:   fly redis create, then copy the private URL
REDIS_URL=redis://default:password@your-redis-host:6379

# ── Auth — comma-separated API keys for multi-user access ─────────────────────
# Leave blank to disable auth (not recommended in production)
# Generate keys: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=key-alice-abc123def456,key-bob-xyz789ghi012

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=20

# Restrict CORS to your frontend origin(s)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
